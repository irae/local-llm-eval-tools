#!/usr/bin/env python3
"""fake-sysctl prints vm.swapusage for the snapshot fake-vm_stat last read.

It reads FAKE_MEM_SCENARIO for the snapshot list and FAKE_MEM_INDEX for
the position fake-vm_stat left behind.
"""

import json
import os
import sys

SCENARIO_PATH = os.environ["FAKE_MEM_SCENARIO"]
INDEX_PATH = os.environ["FAKE_MEM_INDEX"]


def read_index():
    try:
        with open(INDEX_PATH) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return 0


def main():
    if sys.argv[1:] != ["-n", "vm.swapusage"]:
        return
    with open(SCENARIO_PATH) as handle:
        snapshots = json.load(handle)["snapshots"]
    index = max(read_index() - 1, 0)
    snapshot = snapshots[min(index, len(snapshots) - 1)]
    used = snapshot["swap_used_mb"]
    print("total = 4096.00M  used = %.2fM  free = %.2fM" % (used, 4096 - used))


if __name__ == "__main__":
    main()
